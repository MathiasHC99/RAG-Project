    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Dette workflow kaldes af AI-agenten via Call n8n Workflow Tool.\n// Forventet input: { \"query\": \"Find a vegetarian pasta\" }\nconst query = $json.query;\nif (typeof query !== 'string' || !query.trim()) {\n  throw new Error('Missing query: Send a nonempty query string when calling workflow 02 from the AI Agent. Executing this sub-workflow alone does not provide a question.');\n}\nreturn { json: { query: query.trim() } };"
      },
      "name": "Validate question",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "1c7395bb-0c93-405e-9c5c-d36cdf6a36d3",
      "position": [
        224,
        -64
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/embed",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"nomic-embed-text:v1.5\", input: \"search_query: \" + $json.query, truncate: false }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "name": "Embed question",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "id": "9a3db3cb-d886-4a09-a35e-3924e17d74cb",
      "position": [
        464,
        -64
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Ollama /api/embed returnerer { embeddings: [[...]] }.\nconst embedding = $json.embeddings?.[0];\nif (!Array.isArray(embedding) || embedding.length !== 768 || !embedding.every(Number.isFinite)) {\n  throw new Error(`Ollama embedding invalid: expected 768 finite values, received ${Array.isArray(embedding) ? embedding.length : 'none'}. Check nomic-embed-text:v1.5 and workflow 01.`);\n}\nconst statement = `CALL db.index.vector.queryNodes('recipe_embeddings', 10, $embedding)\nYIELD node, score\nRETURN node.id AS id, node.title AS title, node.text AS text,\n       node.minutes AS minutes, node.source AS source, score\nORDER BY score DESC, id`;\nreturn { json: { statement, parameters: { embedding } } };"
      },
      "name": "Prepare vector query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "879f9fcc-e995-45da-877e-d278dde570d6",
