        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 120000
        }
      },
      "name": "Search Neo4j vectors",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "id": "e1fbfa2b-b270-4bd3-a8aa-87b14f3e4ce6",
