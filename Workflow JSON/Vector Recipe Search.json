      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "e09XtlmOaCIqXhaA",
          "name": "Neo4j"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.errors?.length) throw new Error(JSON.stringify($json.errors));\nconst { fields, values } = $json.data ?? {};\nif (!Array.isArray(fields) || !Array.isArray(values)) throw new Error(\"Unexpected Neo4j response\");\nreturn { json: { results: values.map(row =>\n  Object.fromEntries(fields.map((field, index) => [field, row[index]]))\n) } };"
      },
